# Puerto local del servidor HTTP del ERP
PORT=3000

# API Key de Google Gemini (obtener en Google AI Studio). Nunca compartir ni commitear .env
GEMINI_API_KEY=

# Modelo principal preferido de Gemini para extracción estructurada multimodal (PDF, imágenes y texto)
GEMINI_MODEL=gemini-3.8-flash

# Descubrimiento automático y rotación ante cuota/demanda (true por defecto)
GEMINI_AUTO_DISCOVER=true

# Lista opcional separada por comas de modelos de respaldo en orden de prioridad
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
